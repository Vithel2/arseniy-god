<?xml version="1.0" encoding="utf-8"?>
<widget id="com.vithel.arseniygod" version="1.1.2" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Арсений God</name>
    <description>Игра в стиле алхимии: соединяй элементы и проходи квесты.</description>
    <author email="vithel@example.com" href="https://example.com">Vithel</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xffe1d3b6" />
    <preference name="SplashScreenDelay" value="1500" />
    <preference name="AndroidWindowSplashScreenBackground" value="#e1d3b6" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/splash-safe.png" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="DisallowOverscroll" value="true" />
    <platform name="android">
        <hook type="after_prepare" src="scripts/launcher-alias.js" />
        <resource-file src="native/IconSwitcher.java" target="app/src/main/java/com/vithel/arseniygod/IconSwitcher.java" />
        <resource-file src="res/icon.png" target="app/src/main/res/drawable/icon_default.png" />
        <resource-file src="res/icon-dark.png" target="app/src/main/res/drawable/icon_dark.png" />
        <resource-file src="res/icon-green.png" target="app/src/main/res/drawable/icon_green.png" />
        <resource-file src="res/icon-blue.png" target="app/src/main/res/drawable/icon_blue.png" />
        <resource-file src="res/icon-pink.png" target="app/src/main/res/drawable/icon_pink.png" />
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="IconSwitcher"><param name="android-package" value="com.vithel.arseniygod.IconSwitcher" /></feature>
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <activity-alias android:name=".Icon_default" android:targetActivity="MainActivity" android:icon="@drawable/icon_default" android:label="@string/app_name" android:exported="true" android:enabled="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
            <activity-alias android:name=".Icon_dark" android:targetActivity="MainActivity" android:icon="@drawable/icon_dark" android:label="@string/app_name" android:exported="true" android:enabled="false"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
            <activity-alias android:name=".Icon_green" android:targetActivity="MainActivity" android:icon="@drawable/icon_green" android:label="@string/app_name" android:exported="true" android:enabled="false"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
            <activity-alias android:name=".Icon_blue" android:targetActivity="MainActivity" android:icon="@drawable/icon_blue" android:label="@string/app_name" android:exported="true" android:enabled="false"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
            <activity-alias android:name=".Icon_pink" android:targetActivity="MainActivity" android:icon="@drawable/icon_pink" android:label="@string/app_name" android:exported="true" android:enabled="false"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        </config-file>
        <resource-file src="res/icon-dark.png" target="app/src/main/res/mipmap-night/icon.png" />
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.VIBRATE" />
        </config-file>
        <icon density="ldpi" src="res/icon.png" />
        <icon density="mdpi" src="res/icon.png" />
        <icon density="hdpi" src="res/icon.png" />
        <icon density="xhdpi" src="res/icon.png" />
        <icon density="xxhdpi" src="res/icon.png" />
        <icon density="xxxhdpi" src="res/icon.png" />
    </platform>
</widget>
