rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function host() { return signedIn() && resource.data.hostUid == request.auth.uid; }
    function player() { return signedIn() && (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid); }

    match /author_posts/{post} {
      allow read: if true;
      allow create, delete: if signedIn() && request.auth.uid == 'ВСТАВЬ_ADMIN_UID';
      allow update: if signedIn();
      match /comments/{comment} {
        allow read: if true;
        allow create: if signedIn();
      }
    }

    // Public profile fields power friend-code lookup and the leaderboard.
    match /players/{uid} {
      allow read: if true;
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /lobbies/{code} {
      // The client finds a lobby by its six-character code, so authenticated reads are needed.
      allow read: if signedIn();

      // Create only a fresh waiting match owned by the signed-in host.
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.status == 'wait'
        && (request.resource.data.secs == 60 || request.resource.data.secs == 180 || request.resource.data.secs == 300)
        && request.resource.data.deadline == 0
        && request.resource.data.hScore == 0
        && request.resource.data.gScore == 0;

      // One different signed-in account may claim the guest slot; match settings/scores stay fixed.
      allow update: if signedIn()
        && resource.data.status == 'wait'
        && resource.data.guestUid == ''
        && request.auth.uid != resource.data.hostUid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.guestName is string
        && request.resource.data.secs == resource.data.secs
        && request.resource.data.status == 'wait'
        && request.resource.data.deadline == resource.data.deadline
        && request.resource.data.hScore == resource.data.hScore
        && request.resource.data.gScore == resource.data.gScore;

      // Host starts only a waiting lobby after someone has joined. No timestamp conversion required.
      allow update: if host()
        && resource.data.status == 'wait'
        && resource.data.guestUid != ''
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == resource.data.guestUid
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.guestName == resource.data.guestName
        && request.resource.data.secs == resource.data.secs
        && request.resource.data.status == 'go'
        && request.resource.data.deadline is int
        && request.resource.data.deadline > 0
        && request.resource.data.hScore == resource.data.hScore
        && request.resource.data.gScore == resource.data.gScore;

      // During a match, each player can only raise their own integer score.
      allow update: if player()
        && resource.data.status == 'go'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == resource.data.guestUid
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.guestName == resource.data.guestName
        && request.resource.data.secs == resource.data.secs
        && request.resource.data.status == resource.data.status
        && request.resource.data.deadline == resource.data.deadline
        && request.resource.data.created == resource.data.created
        && ((request.auth.uid == resource.data.hostUid
          && request.resource.data.hScore is int
          && request.resource.data.hScore >= resource.data.hScore
          && request.resource.data.gScore == resource.data.gScore)
          || (request.auth.uid == resource.data.guestUid
          && request.resource.data.gScore is int
          && request.resource.data.gScore >= resource.data.gScore
          && request.resource.data.hScore == resource.data.hScore));

      // Host closes the match without changing its players, settings, or final scores.
      allow update: if host()
        && resource.data.status == 'go'
        && request.resource.data.status == 'done'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == resource.data.guestUid
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.guestName == resource.data.guestName
        && request.resource.data.secs == resource.data.secs
        && request.resource.data.deadline == resource.data.deadline
        && request.resource.data.created == resource.data.created
        && request.resource.data.hScore == resource.data.hScore
        && request.resource.data.gScore == resource.data.gScore;

      allow delete: if host();
    }

    match /gifts/{uid}/items/{item} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn();
    }
    match /friends/{uid}/list/{friend} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /invites/{uid}/items/{item} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn();
    }
    match /chats/{pair} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read, update: if signedIn() && request.auth.uid in resource.data.members;
      match /msgs/{message} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(pair)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(pair)).data.members
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
      }
    }
  }
}
