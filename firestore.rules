rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isHost() { return signedIn() && resource.data.hostUid == request.auth.uid; }
    function isPlayer() { return signedIn() && (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid); }
    match /author_posts/{post} {
      allow read: if true;
      allow create, delete: if signedIn() && request.auth.uid == 'ВСТАВЬ_ADMIN_UID';
      allow update: if signedIn();
      match /comments/{comment} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
    }
    match /players/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /lobbies/{code} {
      // A lobby code is already a capability; do not expose the whole collection from the client.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.status == 'wait'
        && request.resource.data.hScore == 0 && request.resource.data.gScore == 0;
      // Claim an empty lobby once. Match settings and scores are immutable here.
      allow update: if signedIn()
        && resource.data.status == 'wait' && resource.data.guestUid == ''
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.secs == resource.data.secs
        && request.resource.data.status == 'wait'
        && request.resource.data.deadline == resource.data.deadline
        && request.resource.data.hScore == resource.data.hScore
        && request.resource.data.gScore == resource.data.gScore;
      // Only the host starts a joined lobby.
      allow update: if isHost()
        && resource.data.status == 'wait' && resource.data.guestUid != ''
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == resource.data.guestUid
        && request.resource.data.guestName == resource.data.guestName
        && request.resource.data.secs == resource.data.secs
        && request.resource.data.status == 'go'
        && request.resource.data.deadline > request.time.toMillis()
        && request.resource.data.hScore == resource.data.hScore
        && request.resource.data.gScore == resource.data.gScore;
      // A player can only increase their own score; all other match fields stay fixed.
      allow update: if isPlayer() && resource.data.status == 'go'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == resource.data.guestUid
        && request.resource.data.guestName == resource.data.guestName
        && request.resource.data.secs == resource.data.secs
        && request.resource.data.status == resource.data.status
        && request.resource.data.deadline == resource.data.deadline
        && ((request.auth.uid == resource.data.hostUid
          && request.resource.data.hScore >= resource.data.hScore
          && request.resource.data.gScore == resource.data.gScore)
          || (request.auth.uid == resource.data.guestUid
          && request.resource.data.gScore >= resource.data.gScore
          && request.resource.data.hScore == resource.data.hScore));
      // Host marks the match finished after the clients have flushed scores.
      allow update: if isHost() && resource.data.status == 'go'
        && request.resource.data.status == 'done'
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == resource.data.guestUid
        && request.resource.data.guestName == resource.data.guestName
        && request.resource.data.secs == resource.data.secs
        && request.resource.data.deadline == resource.data.deadline
        && request.resource.data.hScore == resource.data.hScore
        && request.resource.data.gScore == resource.data.gScore;
      allow delete: if isHost();
    }
    match /gifts/{uid}/items/{item} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn();
    }
    match /friends/{uid}/list/{friend} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /invites/{uid}/items/{item} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn();
    }
    match /chats/{pair} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read, update: if signedIn() && request.auth.uid in resource.data.members;
      match /msgs/{message} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
    }
  }
}
